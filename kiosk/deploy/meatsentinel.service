[Unit]
Description=MeatSentinel Kiosk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi4_01
WorkingDirectory=/home/pi4_01/meatscentinel/kiosk
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi4_01/.Xauthority
ExecStartPre=/bin/sleep 5
ExecStart=/home/pi4_01/meatscentinel/venv/bin/python main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
