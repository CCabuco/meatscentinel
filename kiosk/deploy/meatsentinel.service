[Unit]
Description=MeatSentinel Kiosk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/meatsentinel_kiosk
Environment=DISPLAY=:0
ExecStart=/home/pi/meatsentinel_kiosk/venv/bin/python main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
