# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Shared Supabase project (same one the web dashboard uses)
SUPABASE_URL=https://your-project-ref.supabase.co

# Must match the DEVICE_SECRET set on the submit-inspection Edge Function:
#   npx.cmd supabase secrets set DEVICE_SECRET=...
# Use a long random value (32+ characters).
DEVICE_SECRET=paste-the-device-secret-here

# Optional. The public publishable key (sb_publishable_...), sent as the
# apikey header. Safe to put here; it grants nothing on its own.
SUPABASE_PUBLISHABLE_KEY=

# Do NOT put SUPABASE_SERVICE_KEY here. The kiosk no longer uses it.
